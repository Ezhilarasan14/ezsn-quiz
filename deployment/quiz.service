[Unit]
Description=EZSN Quiz Rust Application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/quiz
EnvironmentFile=-/var/www/quiz/.env
Environment=PORT=8081
Environment=HOST=127.0.0.1
Environment=DATABASE_URL=sqlite:/var/www/quiz/quiz.db
ExecStart=/var/www/quiz/ezsn_quiz
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ezsn_quiz

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/quiz

[Install]
WantedBy=multi-user.target
