[Unit]
Description=EZSN Quiz Rust Application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/quiz
Environment=PORT=8081
Environment=HOST=127.0.0.1
Environment=DATABASE_URL=postgres://postgres:postgres@localhost:5432/esan_quiz
Environment=RUST_LOG=info
EnvironmentFile=-/var/www/quiz/.env
ExecStart=/var/www/quiz/ezsn_quiz
Restart=always
RestartSec=3
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ezsn_quiz

[Install]
WantedBy=multi-user.target
