# EZSN Quiz - Configuration Template

# Server Network Binding
HOST=0.0.0.0
PORT=8081

# Database Configuration (PostgreSQL)
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgres://username:password@localhost:5432/esan_quiz

# Logging Configuration (error, warn, info, debug, trace)
RUST_LOG=info

# Default Quiz Question Answer Duration (fallback if not set on the question itself, e.g. 10, 20, 30, 60)
QUIZ_QUESTION_TIME_SECONDS=60

# Google OAuth 2.0 / OpenID Connect (Optional: enables Google Single Sign-On for Admins)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
# GOOGLE_REDIRECT_URL=http://localhost:8081/api/auth/google/callback
# ADMIN_ALLOWED_EMAILS=admin@ezsnapps.in,lead@example.com

# Background Room Sweeper Intervals (in seconds)
CLEANUP_INTERVAL_SECS=60
ROOM_ABANDONED_TIMEOUT_SECS=1800
MAX_ROOM_LIFETIME_SECS=18000
