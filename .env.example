# EZSN Quiz - Configuration Template

# Server Network Binding
HOST=0.0.0.0
PORT=8081

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/esan_quiz

# Logging Configuration (error, warn, info, debug, trace)
RUST_LOG=info

# Background Room Sweeper Intervals (in seconds)
CLEANUP_INTERVAL_SECS=60
ROOM_ABANDONED_TIMEOUT_SECS=900
MAX_ROOM_LIFETIME_SECS=7200
